# ZeroGuard Self-Hosted AI Engine Configuration

# LLM Provider Configuration (Options: ollama, vllm, openai, custom)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3:8b
LLM_API_KEY=EMPTY

# Alternative: vLLM configuration example
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zeroguard_security_knowledge

# Cache & Conversation Memory (Valkey / Redis)
VALKEY_URL=redis://localhost:6379/0

# Event Stream (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_EVENTS_TOPIC=zeroguard-findings
